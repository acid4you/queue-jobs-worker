{
  "name": "queue-jobs-worker",
  "version": "2.0.0",
  "description": "Reliable background job queue and worker system for Node.js — supports in-memory, Redis, PostgreSQL, and MySQL with retries, concurrency, scheduling, and failure recovery.",
  "homepage": "https://github.com/rafidahmed870/queue-jobs-worker#readme",
  "bugs": {
    "url": "https://github.com/rafidahmed870/queue-jobs-worker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafidahmed870/queue-jobs-worker.git"
  },
  "license": "MIT",
  "author": "Rafid Ahmed",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "build:tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "queue",
    "worker",
    "job",
    "background",
    "task",
    "scheduler",
    "cron",
    "redis",
    "postgres",
    "mysql",
    "retry",
    "concurrency"
  ],
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "peerDependencies": {
    "mysql2": ">=3.0.0",
    "pg": ">=8.0.0",
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  }
}
